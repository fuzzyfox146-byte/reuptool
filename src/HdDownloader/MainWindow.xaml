<Window x:Class="HdDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:HdDownloader.Resources"
        Title="{x:Static t:UiText.Title}"
        Height="760" Width="1180"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="16" Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{x:Static t:UiText.Title}" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="{x:Static t:UiText.Blurb}" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <Label Content="{x:Static t:UiText.YtDlp}"/>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="{x:Static t:UiText.Browse}" Margin="8,0,0,0"
                            Command="{Binding BrowseYtDlpCommand}"/>
                    <TextBox Text="{Binding YtDlpPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                </DockPanel>
                <Label Content="{x:Static t:UiText.Cookies}"/>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="{x:Static t:UiText.Browse}" Margin="8,0,0,0"
                            Command="{Binding BrowseCookiesCommand}"/>
                    <TextBox Text="{Binding CookiesPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                </DockPanel>
                <Label Content="{x:Static t:UiText.Root}"/>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="{x:Static t:UiText.Browse}" Margin="8,0,0,0"
                            Command="{Binding BrowseRootCommand}"/>
                    <TextBox Text="{Binding RootFolder, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel>
                        <Label Content="{x:Static t:UiText.Quality}"/>
                        <ComboBox Width="110" HorizontalAlignment="Left"
                                  ItemsSource="{Binding QualityOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding Quality}"/>
                    </StackPanel>
                    <StackPanel Margin="16,0,0,0">
                        <Label Content="{x:Static t:UiText.Parallel}"/>
                        <ComboBox Width="80" HorizontalAlignment="Left"
                                  ItemsSource="{Binding ParallelOptions}"
                                  SelectedItem="{Binding Parallel}"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <Button Content="{x:Static t:UiText.AddChannel}" Margin="0,0,0,8" Padding="8,8"
                        Command="{Binding AddChannelCommand}"/>
                <Button Content="{x:Static t:UiText.StartAll}" Margin="0,0,0,8" Padding="8,8"
                        Command="{Binding StartAllCommand}"
                        IsEnabled="{Binding CanStart}"/>
                <Button Content="{x:Static t:UiText.StopAll}" Padding="8,8"
                        Command="{Binding StopAllCommand}"
                        Background="{StaticResource ErrorBrush}"/>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static t:UiText.Folder}"/>
                <TextBlock Grid.Column="2" Text="{x:Static t:UiText.Link}"/>
                <TextBlock Grid.Column="3" Text="{x:Static t:UiText.From}"/>
                <TextBlock Grid.Column="4" Text="{x:Static t:UiText.To}"/>
                <TextBlock Grid.Column="5" Text="{x:Static t:UiText.Number}"/>
                <TextBlock Grid.Column="6" Text="{x:Static t:UiText.Progress}"/>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Channels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,0,4,0" IsEnabled="{Binding CanEdit}"
                                             Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Margin="0,0,4,0" Content="{x:Static t:UiText.Browse}"
                                            Command="{Binding DataContext.BrowseChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBox Grid.Column="2" Margin="0,0,4,0" IsEnabled="{Binding CanEdit}"
                                             Text="{Binding ChannelUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="3" Margin="0,0,4,0" IsEnabled="{Binding CanEdit}"
                                             Text="{Binding PlaylistStart, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="4" Margin="0,0,4,0" IsEnabled="{Binding CanEdit}"
                                             Text="{Binding PlaylistEnd, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="5" Margin="0,0,4,0" IsEnabled="{Binding CanEdit}"
                                             Text="{Binding NameStart, UpdateSourceTrigger=PropertyChanged}"/>
                                    <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding VideoProgress}"/>
                                        <TextBlock Text="{Binding ThumbProgress}"/>
                                    </StackPanel>
                                    <Button Grid.Column="7" Margin="0,0,4,0" Content="{x:Static t:UiText.Start}"
                                            Command="{Binding DataContext.StartChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.CanStart, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Button Grid.Column="8" Content="{x:Static t:UiText.Remove}"
                                            Command="{Binding DataContext.RemoveChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanEdit}"/>
                                </Grid>
                                <TextBlock Text="{Binding LayoutText}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <DockPanel Grid.Row="3">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" FontWeight="Bold" Margin="0,8,0,0"/>
            <TextBlock DockPanel.Dock="Top" Text="{x:Static t:UiText.Log}"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,4"/>
            <ListBox ItemsSource="{Binding LogLines}"
                     Background="{StaticResource SurfaceBrush}"/>
        </DockPanel>
    </Grid>
</Window>
