<Window x:Class="HdDownloader.Views.PasteChannelsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập danh sách link kênh (Paste từ Excel / Google Sheets)"
        Height="540" Width="740"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Nhập danh sách kênh hàng loạt" FontSize="18" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Copy các hàng từ Google Sheets hoặc Excel (Cột 1: Tên folder, Cột 2: Link kênh) rồi dán vào khung bên dưới. Tool sẽ tự động nhận diện và tạo đúng folder theo đường dẫn D:\..."/>

        <!-- Text Input -->
        <TextBox x:Name="InputBox" Grid.Row="2"
                 AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Segoe UI" FontSize="13"
                 Padding="8"/>

        <!-- Preview & Options -->
        <DockPanel Grid.Row="3" Margin="0,12,0,14">
            <TextBlock x:Name="CountText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"
                       Text="Tìm thấy: 0 kênh"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="ReplaceCheck" Content="Xóa danh sách cũ trong app" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button x:Name="PasteClipboardBtn" Content="📋 Dán từ Clipboard" Padding="12,6" Click="PasteClipboardBtn_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Actions -->
        <DockPanel Grid.Row="4">
            <Button x:Name="CancelBtn" DockPanel.Dock="Right" Content="Đóng" Width="90" Click="CancelBtn_Click" Margin="8,0,0,0"/>
            <Button x:Name="ImportBtn" DockPanel.Dock="Right" Content="✓ Nhập vào danh sách tải" Padding="16,8"
                    Background="{StaticResource AccentBrush}" FontWeight="Bold" Click="ImportBtn_Click"/>
        </DockPanel>
    </Grid>
</Window>
