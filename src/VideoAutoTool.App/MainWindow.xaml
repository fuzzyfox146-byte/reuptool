<Window x:Class="VideoAutoTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:VideoAutoTool.App.Controls"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding DesignViewModel.UndoCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="Z" Command="{Binding DesignViewModel.RedoCommand}"/>
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding DesignViewModel.RedoCommand}"/>
    </Window.InputBindings>
    <Grid>
        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <!-- Tab Thiết kế -->
            <TabItem Header="Thiết kế">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Layer List -->
                    <Border Grid.Column="0" Background="#FF252526" Margin="5">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="5">
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="↶ Hoàn tác" Command="{Binding DesignViewModel.UndoCommand}" Margin="0,0,2,0" ToolTip="Ctrl+Z"/>
                                    <Button Grid.Column="1" Content="↷ Làm lại" Command="{Binding DesignViewModel.RedoCommand}" Margin="2,0,0,0" ToolTip="Ctrl+Shift+Z"/>
                                </Grid>
                                <Button Content="💾 Lưu Draft" Command="{Binding DesignViewModel.SaveDraftCommand}" Margin="0,5"/>
                                <Button Content="📂 Tải Draft" Command="{Binding DesignViewModel.LoadDraftCommand}" Margin="0,5"/>
                            </StackPanel>
                            <StackPanel>
                                <!-- Legend for checkboxes -->
                                <Grid Margin="5,0,5,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="👁️" FontSize="10" HorizontalAlignment="Center" ToolTip="Hiện/Ẩn"/>
                                    <TextBlock Grid.Column="1" Text="🔒" FontSize="10" HorizontalAlignment="Center" ToolTip="Khóa"/>
                                    <TextBlock Grid.Column="2" Text="❄️" FontSize="10" HorizontalAlignment="Center" ToolTip="Đóng băng"/>
                                    <TextBlock Grid.Column="3" Text="Tên layer" FontSize="10" Margin="5,0"/>
                                </Grid>
                                <ListBox ItemsSource="{Binding DesignViewModel.Layers}" 
                                         SelectedItem="{Binding DesignViewModel.SelectedLayerItem}"
                                         Height="400">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsVisible}" Margin="2" ToolTip="👁️ Hiện/Ẩn: Bỏ tick = ẩn layer"/>
                                                <CheckBox IsChecked="{Binding IsLocked}" Margin="2" ToolTip="🔒 Khóa: Tick = không kéo thả được"/>
                                                <CheckBox IsChecked="{Binding IsFrozen}" Margin="2" ToolTip="❄️ Đóng băng: Tick = cache layer (render nhanh)"/>
                                                <TextBlock Text="{Binding DisplayName}" Width="120" Margin="5,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Canvas -->
                    <controls:DesignCanvasControl Grid.Column="1" Margin="5" 
                                                   Layers="{Binding DesignViewModel.Layers}"
                                                   SelectedLayer="{Binding DesignViewModel.SelectedLayerItem, Mode=TwoWay}"
                                                   History="{Binding DesignViewModel.History}"/>

                    <!-- Properties Panel -->
                    <Border Grid.Column="2" Background="#FF252526" Margin="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="5">
                                <TextBlock Text="Thuộc tính" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding DesignViewModel.SelectedLayerItem.DisplayName, FallbackValue='(Chưa chọn layer)'}" 
                                           FontStyle="Italic" Margin="0,0,0,8"/>

                                <TextBlock Text="Vị trí (Position)" FontWeight="Bold" Margin="0,5,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Label Grid.Row="0" Grid.Column="0" Content="X:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DesignViewModel.SelectedLayerItem.X, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" Margin="2"/>
                                    
                                    <Label Grid.Row="1" Grid.Column="0" Content="Y:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DesignViewModel.SelectedLayerItem.Y, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" Margin="2"/>
                                </Grid>

                                <TextBlock Text="Kích thước (Size)" FontWeight="Bold" Margin="0,10,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Label Grid.Row="0" Grid.Column="0" Content="Rộng (W):" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DesignViewModel.SelectedLayerItem.LayerWidth, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" Margin="2"/>
                                    
                                    <Label Grid.Row="1" Grid.Column="0" Content="Cao (H):" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DesignViewModel.SelectedLayerItem.LayerHeight, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" Margin="2"/>
                                </Grid>
                                <TextBlock Text="Kéo góc/cạnh trên canvas để đổi rộng &amp; cao độc lập." 
                                           FontSize="11" Foreground="#FF9E9E9E" TextWrapping="Wrap" Margin="2,4,2,5"/>

                                <StackPanel Visibility="{Binding DesignViewModel.IsTextStyleVisible, Converter={StaticResource BoolToVis}}">
                                    <Separator Margin="0,10"/>
                                    <TextBlock Text="Kiểu chữ (Style)" FontWeight="Bold" Margin="0,5,0,6"/>
                                    <ComboBox ItemsSource="{Binding DesignViewModel.StylePresets}"
                                              SelectedItem="{Binding DesignViewModel.SelectedStylePreset}"
                                              DisplayMemberPath="DisplayName" Margin="0,0,0,8"/>
                                    <TextBlock Text="Font" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding DesignViewModel.FontOptions}"
                                              SelectedItem="{Binding DesignViewModel.SelectedFontOption}"
                                              DisplayMemberPath="DisplayLabel" Margin="0,0,0,6"/>
                                    <Button Content="Import font (.ttf/.otf)" Command="{Binding DesignViewModel.ImportFontCommand}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Grid.Column="0" Content="Cỡ:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DesignViewModel.SelectedStylePreset.Size, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Đậm (Bold)" IsChecked="{Binding DesignViewModel.SelectedStylePreset.Bold}" Margin="2,4"/>
                                        <Label Grid.Row="2" Grid.Column="0" Content="Màu:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DesignViewModel.SelectedStylePreset.Color, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="3" Grid.Column="0" Content="Viền:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DesignViewModel.SelectedStylePreset.OutlineColor, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="4" Grid.Column="0" Content="Độ viền:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DesignViewModel.SelectedStylePreset.Outline, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                    </Grid>
                                    <TextBlock Text="Chọn layer Phụ đề hoặc Text cố định để sửa style. Màu dạng #RRGGBB."
                                               FontSize="11" Foreground="#FF9E9E9E" TextWrapping="Wrap" Margin="2,6,2,0"/>
                                </StackPanel>

                                <Separator Margin="0,10"/>
                                <TextBlock Text="Trạng thái:" FontWeight="Bold" Margin="0,5,0,2"/>
                                <TextBlock Text="{Binding DesignViewModel.Status}" TextWrapping="Wrap" Margin="5"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab Nguồn & Kiểm tra -->
            <TabItem Header="Nguồn &amp; Kiểm tra">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="180"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Nguồn &amp; Kiểm tra" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Chọn thư mục gốc bằng Duyệt. Tool chỉ liệt kê folder theo vai trò render, đếm file tầng trên — không đọc hết nội dung bên trong."
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SourceViewModel.RootFolder, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True"
                                     ToolTip="Chọn bằng nút Duyệt"/>
                            <Button Grid.Column="1" Content="Duyệt..." Margin="8,0,0,0" Padding="12,4"
                                    Command="{Binding SourceViewModel.BrowseRootCommand}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Quét folder" Margin="0,0,8,0"
                                    Command="{Binding SourceViewModel.RefreshFolderStatsCommand}"/>
                            <Button Content="Kiểm tra sâu (ffprobe)"
                                    Command="{Binding SourceViewModel.ValidateDeepCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SourceViewModel.Status}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding SourceViewModel.Folders}"
                              AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sẵn sàng" Binding="{Binding ReadyMark}" Width="80"/>
                            <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleLabel}" Width="180"/>
                            <DataGridTextColumn Header="Dùng" Binding="{Binding RenderMark}" Width="80"/>
                            <DataGridTextColumn Header="Loại file" Binding="{Binding ExtensionsLabel}" Width="160"/>
                            <DataGridTextColumn Header="Số file" Binding="{Binding FileCount}" Width="70"/>
                            <DataGridTextColumn Header="Thư mục" Binding="{Binding FolderPath}" Width="*"/>
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Duyệt..." Command="{Binding BrowseCommand}" Padding="8,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="Kết quả kiểm tra sâu" FontWeight="Bold" Margin="0,0,0,6"/>
                    <DataGrid Grid.Row="3" ItemsSource="{Binding SourceViewModel.ValidationMessages}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab Hàng đợi -->
            <TabItem Header="Hàng đợi">
                <Grid Margin="16">
                    <StackPanel>
                        <TextBlock Text="Hàng đợi Render" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding QueueViewModel.JobCount, StringFormat='Số job: {0}'}" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Chạy" Margin="0,0,8,0"/>
                            <Button Content="Tạm dừng" Margin="0,0,8,0"/>
                            <Button Content="Hủy" Background="{StaticResource ErrorBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab Cài đặt -->
            <TabItem Header="Cài đặt">
                <Grid Margin="16">
                    <StackPanel>
                        <TextBlock Text="Cài đặt" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                        
                        <Label Content="Đường dẫn FFmpeg:"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SettingsViewModel.FfmpegPath}" Grid.Column="0" Margin="0,0,8,0"/>
                            <Button Content="Dò tìm" Grid.Column="1"/>
                        </Grid>

                        <Label Content="Số job song song:"/>
                        <ComboBox SelectedValue="{Binding SettingsViewModel.ParallelCount}" Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="1" IsSelected="True"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
