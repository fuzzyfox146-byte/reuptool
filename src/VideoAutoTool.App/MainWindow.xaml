<Window x:Class="VideoAutoTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:VideoAutoTool.App.Controls"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing">
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveAllCommand}"/>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding DesignViewModel.UndoCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="Z" Command="{Binding DesignViewModel.RedoCommand}"/>
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding DesignViewModel.RedoCommand}"/>
    </Window.InputBindings>
    <Grid>
        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <!-- Tab Thiết kế -->
            <TabItem Header="Thiết kế">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Layer List -->
                    <Border Grid.Column="0" Background="#FF252526" Margin="5">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="5">
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="↶ Hoàn tác" Command="{Binding DesignViewModel.UndoCommand}" Margin="0,0,2,0" ToolTip="Ctrl+Z"/>
                                    <Button Grid.Column="1" Content="↷ Làm lại" Command="{Binding DesignViewModel.RedoCommand}" Margin="2,0,0,0" ToolTip="Ctrl+Shift+Z"/>
                                </Grid>
                                <Button Content="💾 Lưu bản mới" Command="{Binding DesignViewModel.SaveDraftCommand}" Margin="0,5"
                                        ToolTip="Tạo file JSON design mới (không ghi đè). Ctrl+S lưu toàn bộ phiên hiện tại."/>
                                <Button Content="Ctrl+S Lưu tất cả" Command="{Binding SaveAllCommand}" Margin="0,5"
                                        ToolTip="Lưu design hiện tại + folder nguồn + cài đặt. Ghi đè file design đang mở."/>
                                <Button Content="📂 Mở bản cũ" Command="{Binding DesignViewModel.LoadDraftCommand}" Margin="0,5"
                                        ToolTip="Mở lại một file JSON đã lưu."/>
                            </StackPanel>
                            <StackPanel>
                                <!-- Legend for checkboxes -->
                                <Grid Margin="5,0,5,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="👁️" FontSize="10" HorizontalAlignment="Center" ToolTip="Hiện/Ẩn"/>
                                    <TextBlock Grid.Column="1" Text="🔒" FontSize="10" HorizontalAlignment="Center" ToolTip="Khóa"/>
                                    <TextBlock Grid.Column="2" Text="❄️" FontSize="10" HorizontalAlignment="Center" ToolTip="Đóng băng"/>
                                    <TextBlock Grid.Column="3" Text="Tên layer" FontSize="10" Margin="5,0"/>
                                </Grid>
                                <ListBox ItemsSource="{Binding DesignViewModel.Layers}" 
                                         SelectedItem="{Binding DesignViewModel.SelectedLayerItem}"
                                         Height="400">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsVisible}" Margin="2" ToolTip="👁️ Hiện/Ẩn: Bỏ tick = ẩn layer"/>
                                                <CheckBox IsChecked="{Binding IsLocked}" Margin="2" ToolTip="🔒 Khóa: Tick = không kéo thả được"/>
                                                <CheckBox IsChecked="{Binding IsFrozen}" Margin="2" ToolTip="❄️ Đóng băng: Tick = cache layer (render nhanh)"/>
                                                <TextBlock Text="{Binding DisplayName}" Width="120" Margin="5,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Canvas -->
                    <controls:DesignCanvasControl Grid.Column="1" Margin="5" 
                                                   Layers="{Binding DesignViewModel.Layers}"
                                                   SelectedLayer="{Binding DesignViewModel.SelectedLayerItem, Mode=TwoWay}"
                                                   History="{Binding DesignViewModel.History}"/>

                    <!-- Properties Panel -->
                    <Border Grid.Column="2" Background="#FF252526" Margin="5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="5">
                                <TextBlock Text="Thuộc tính" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding DesignViewModel.SelectedLayerItem.DisplayName, FallbackValue='(Chưa chọn layer)'}" 
                                           FontStyle="Italic" Margin="0,0,0,8"/>

                                <TextBlock Text="Vị trí (Position)" FontWeight="Bold" Margin="0,5,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Label Grid.Row="0" Grid.Column="0" Content="X:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DesignViewModel.SelectedLayerItem.X, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" Margin="2"/>
                                    
                                    <Label Grid.Row="1" Grid.Column="0" Content="Y:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DesignViewModel.SelectedLayerItem.Y, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" Margin="2"/>
                                </Grid>

                                <TextBlock Text="Kích thước (Size)" FontWeight="Bold" Margin="0,10,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Label Grid.Row="0" Grid.Column="0" Content="Rộng (W):" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DesignViewModel.SelectedLayerItem.LayerWidth, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" Margin="2"/>
                                    
                                    <Label Grid.Row="1" Grid.Column="0" Content="Cao (H):" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DesignViewModel.SelectedLayerItem.LayerHeight, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" Margin="2"/>
                                </Grid>
                                <TextBlock Text="Kéo góc/cạnh trên canvas để đổi rộng &amp; cao độc lập." 
                                           FontSize="11" Foreground="#FF9E9E9E" TextWrapping="Wrap" Margin="2,4,2,5"/>

                                <StackPanel Visibility="{Binding DesignViewModel.IsTextStyleVisible, Converter={StaticResource BoolToVis}}">
                                    <Separator Margin="0,10"/>
                                    <TextBlock Text="Kiểu chữ (Style)" FontWeight="Bold" Margin="0,5,0,6"/>
                                    <ComboBox ItemsSource="{Binding DesignViewModel.StylePresets}"
                                              SelectedItem="{Binding DesignViewModel.SelectedStylePreset}"
                                              DisplayMemberPath="DisplayName" Margin="0,0,0,8"/>
                                    <TextBlock Text="Font" Margin="0,0,0,2"/>
                                    <ComboBox ItemsSource="{Binding DesignViewModel.FontOptions}"
                                              SelectedItem="{Binding DesignViewModel.SelectedFontOption}"
                                              DisplayMemberPath="DisplayLabel" Margin="0,0,0,6"/>
                                    <Button Content="Import font (.ttf/.otf)" Command="{Binding DesignViewModel.ImportFontCommand}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Grid.Column="0" Content="Cỡ:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DesignViewModel.SelectedStylePreset.Size, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Đậm (Bold)" IsChecked="{Binding DesignViewModel.SelectedStylePreset.Bold}" Margin="2,4"/>
                                        <Label Grid.Row="2" Grid.Column="0" Content="Màu:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DesignViewModel.SelectedStylePreset.Color, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="3" Grid.Column="0" Content="Viền:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DesignViewModel.SelectedStylePreset.OutlineColor, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="4" Grid.Column="0" Content="Độ viền:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DesignViewModel.SelectedStylePreset.Outline, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                    </Grid>
                                    <TextBlock Text="Chọn layer Phụ đề hoặc Text cố định để sửa style. Màu dạng #RRGGBB."
                                               FontSize="11" Foreground="#FF9E9E9E" TextWrapping="Wrap" Margin="2,6,2,0"/>
                                </StackPanel>

                                <Separator Margin="0,10"/>
                                <TextBlock Text="Trạng thái:" FontWeight="Bold" Margin="0,5,0,2"/>
                                <TextBlock Text="{Binding DesignViewModel.Status}" TextWrapping="Wrap" Margin="5"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab Nguồn & Kiểm tra -->
            <TabItem Header="Nguồn &amp; Kiểm tra">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="140"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Nguồn &amp; Kiểm tra" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Chọn template cho kênh này, duyệt folder, rồi thêm một số video hoặc cả nguồn vào hàng đợi. Đang render vẫn thêm được nguồn khác."
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Template design" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding SourceViewModel.DesignOptions}"
                                  SelectedItem="{Binding SourceViewModel.SelectedDesign}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SourceViewModel.RootFolder, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True"
                                     ToolTip="Chọn bằng nút Duyệt"/>
                            <Button Grid.Column="1" Content="Duyệt..." Margin="8,0,0,0" Padding="12,4"
                                    Command="{Binding SourceViewModel.BrowseRootCommand}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Quét folder" Margin="0,0,8,0"
                                    Command="{Binding SourceViewModel.RefreshFolderStatsCommand}"/>
                            <Button Content="Kiểm tra sâu (ffprobe)" Margin="0,0,16,0"
                                    Command="{Binding SourceViewModel.ValidateDeepCommand}"/>
                            <Button Content="Render thử" Margin="0,0,8,0"
                                    Command="{Binding SourceViewModel.TestRenderCommand}"
                                    ToolTip="Encode ~8 giây job đầu tiên (file *_test.mp4). Có thể thêm khi hàng đợi đang chạy."/>
                            <TextBox Width="52" Margin="0,0,8,0" VerticalAlignment="Center"
                                     ToolTip="Số video lấy từ nguồn này cho lần thêm hàng đợi."
                                     Text="{Binding SourceViewModel.RenderCount, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Render số này" Margin="0,0,8,0"
                                    Command="{Binding SourceViewModel.RenderCountCommand}"
                                    ToolTip="Đưa đúng số video ở ô bên cạnh vào hàng đợi. Nguồn khác vẫn render tiếp."/>
                            <Button Content="Render hết"
                                    Command="{Binding SourceViewModel.RenderAllCommand}"
                                    ToolTip="Đưa mọi video của nguồn này vào hàng đợi."/>
                        </StackPanel>
                        <TextBlock Text="{Binding SourceViewModel.Status}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding SourceViewModel.Folders}"
                              AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sẵn sàng" Binding="{Binding ReadyMark}" Width="80"/>
                            <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleLabel}" Width="180"/>
                            <DataGridTextColumn Header="Dùng" Binding="{Binding RenderMark}" Width="80"/>
                            <DataGridTextColumn Header="Loại file" Binding="{Binding ExtensionsLabel}" Width="160"/>
                            <DataGridTextColumn Header="Số file" Binding="{Binding FileCount}" Width="70"/>
                            <DataGridTextColumn Header="Thư mục" Binding="{Binding FolderPath}" Width="*"/>
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Duyệt..." Command="{Binding BrowseCommand}" Padding="8,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="Kết quả kiểm tra sâu" FontWeight="Bold" Margin="0,0,0,6"/>
                    <DataGrid Grid.Row="3" ItemsSource="{Binding SourceViewModel.ValidationMessages}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab Hàng đợi -->
            <TabItem Header="Hàng đợi">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="220"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Tạm dừng" Margin="0,0,8,0"
                                    Command="{Binding QueueViewModel.PauseCommand}"/>
                            <Button Content="Tiếp tục" Margin="0,0,8,0"
                                    Command="{Binding QueueViewModel.ResumeCommand}"/>
                            <Button Content="Hủy" Margin="0,0,8,0" Background="{StaticResource ErrorBrush}"
                                    Command="{Binding QueueViewModel.CancelCommand}"/>
                            <Button Content="Render tiếp" Margin="0,0,8,0"
                                    Command="{Binding QueueViewModel.RenderAgainCommand}"
                                    ToolTip="Đưa video đã hủy và video lỗi về chờ, rồi chạy lại. Video đã xong giữ nguyên."/>
                            <Button Content="Xóa hàng đợi"
                                    Command="{Binding QueueViewModel.ClearQueueCommand}"
                                    ToolTip="Xóa hết job trên màn hình để thêm nguồn mới."/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0"
                                   Text="{Binding QueueViewModel.ElapsedText, StringFormat='Thời gian encode: {0}'}"/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                   Text="{Binding QueueViewModel.EncoderLabel}"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Hàng chính" FontWeight="Bold" Margin="0,0,0,6"/>
                                <ProgressBar DockPanel.Dock="Bottom" Height="8" Margin="0,8,0,0"
                                             Minimum="0" Maximum="1"
                                             Value="{Binding QueueViewModel.OverallProgress}"/>
                                <DataGrid ItemsSource="{Binding QueueViewModel.Jobs}"
                                          SelectedItem="{Binding QueueViewModel.SelectedJob}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nguồn" Binding="{Binding SourceLabel}" Width="120"/>
                                        <DataGridTemplateColumn Header="File xuất" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding OutputShort}"
                                                               ToolTip="{Binding OutputFile}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusShort}" Width="170"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Nguồn đang chờ" FontWeight="Bold" Margin="0,0,0,6"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding QueueViewModel.Intakes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander Header="{Binding Header}" IsExpanded="{Binding IsExpanded}" Margin="0,0,0,6">
                                                    <ItemsControl ItemsSource="{Binding WaitingFiles}" Margin="8,0,0,4">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <DockPanel Grid.Row="2" Margin="0,8,0,4">
                        <Button DockPanel.Dock="Right" Content="Copy lỗi / chi tiết"
                                Command="{Binding QueueViewModel.CopySelectedDetailsCommand}"
                                Padding="10,2" Margin="8,0,0,0"
                                ToolTip="Copy toàn bộ trạng thái, đường dẫn và lỗi ffmpeg của job đang chọn."/>
                        <TextBlock Text="Encoding" FontWeight="Bold"/>
                        <TextBlock Margin="12,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding QueueViewModel.Status}"/>
                    </DockPanel>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Chi tiết / lỗi" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding QueueViewModel.SelectedJob.DetailBody, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="{StaticResource SurfaceBrush}"
                                     AcceptsReturn="True"/>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="Nhật ký hàng đợi" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ListBox ItemsSource="{Binding QueueViewModel.LogLines}"
                                     Background="{StaticResource SurfaceBrush}"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab Tải nguồn -->
            <TabItem Header="Tải nguồn">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="170"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Tải nguồn" FontSize="20" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"
                                   Text="Mỗi dòng là một kênh, tải riêng. Dừng chỉ dừng kênh đó, bấm Tải tiếp để tải phần còn thiếu. Đang tải vẫn thêm kênh khác được. File đã có thì bỏ qua."/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <Label Content="yt-dlp.exe"/>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Duyệt..." Margin="8,0,0,0"
                                        Command="{Binding DownloadViewModel.BrowseYtDlpCommand}"/>
                                <TextBox Text="{Binding DownloadViewModel.YtDlpPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                            </DockPanel>
                            <Label Content="Cookie dùng chung (cookies.txt)"/>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Đổi cookie..." Margin="8,0,0,0"
                                        Command="{Binding DownloadViewModel.BrowseCookiesCommand}"/>
                                <TextBox Text="{Binding DownloadViewModel.CookiesPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                            </DockPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel>
                                    <Label Content="Chất lượng video"/>
                                    <ComboBox Width="100" HorizontalAlignment="Left"
                                              ItemsSource="{Binding DownloadViewModel.QualityOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding DownloadViewModel.VideoQuality}"/>
                                </StackPanel>
                                <StackPanel Margin="16,0,0,0">
                                    <Label Content="Số kênh tải cùng lúc"/>
                                    <ComboBox ItemsSource="{Binding DownloadViewModel.ParallelOptions}"
                                              SelectedItem="{Binding DownloadViewModel.DownloadParallel}"
                                              Width="80" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Button Content="Thêm kênh" Margin="0,0,0,6" Padding="8,6"
                                    Command="{Binding DownloadViewModel.AddChannelCommand}"/>
                            <Button Content="Tải tất cả" Padding="8,6"
                                    Command="{Binding DownloadViewModel.StartCommand}"
                                    ToolTip="Chỉ bắt đầu các kênh đang không tải. Kênh đang chạy giữ nguyên."/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Grid.Row="2">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Folder cha"/>
                            <TextBlock Grid.Column="2" Text="Link kênh"/>
                            <TextBlock Grid.Column="3" Text="Từ"/>
                            <TextBlock Grid.Column="4" Text="Đến"/>
                            <TextBlock Grid.Column="5" Text="Số"/>
                            <TextBlock Grid.Column="6" Text="Ngôn ngữ"/>
                            <TextBlock Grid.Column="7" Text="Tiến độ"/>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DownloadViewModel.Channels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Margin="0,0,4,0" IsEnabled="{Binding CanEdit}"
                                                     Text="{Binding ParentFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Grid.Column="1" Content="Duyệt" Margin="0,0,4,0"
                                                    Command="{Binding BrowseCommand}"/>
                                            <TextBox Grid.Column="2" Margin="0,0,4,0" IsEnabled="{Binding CanEdit}"
                                                     Text="{Binding ChannelUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Grid.Column="3" Margin="0,0,4,0" IsEnabled="{Binding CanEdit}"
                                                     Text="{Binding PlaylistStart, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Grid.Column="4" Margin="0,0,4,0" IsEnabled="{Binding CanEdit}"
                                                     Text="{Binding PlaylistEnd, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Grid.Column="5" Margin="0,0,4,0" IsEnabled="{Binding CanEdit}"
                                                     Text="{Binding NameStart, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Grid.Column="6" Margin="0,0,4,0" IsEnabled="{Binding CanEdit}"
                                                     Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}"/>
                                            <StackPanel Grid.Column="7" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding VideoProgress}"/>
                                                <TextBlock Text="{Binding TextProgress}"/>
                                            </StackPanel>
                                            <Button Grid.Column="8" Content="{Binding StartLabel}" Margin="0,0,4,0"
                                                    Command="{Binding StartCommand}"/>
                                            <Button Grid.Column="9" Content="Dừng" Margin="0,0,4,0"
                                                    Command="{Binding StopCommand}"/>
                                            <Button Grid.Column="10" Content="Xóa lịch sử" Margin="0,0,4,0"
                                                    ToolTip="App không còn ghi file lịch sử. Muốn tải lại từ 001 thì xóa file trong source và text, giữ Từ = 1 và Số đặt tên = 1."
                                                    Command="{Binding ClearArchiveCommand}"/>
                                            <Button Grid.Column="11" Content="Xóa"
                                                    Command="{Binding RemoveCommand}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <DockPanel Grid.Row="3">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DownloadViewModel.Status}" FontWeight="Bold" Margin="0,8,0,0"/>
                        <TextBlock DockPanel.Dock="Top" Text="Nhật ký, 20 dòng cuối" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ListBox ItemsSource="{Binding DownloadViewModel.LogLines}"
                                 Background="{StaticResource SurfaceBrush}"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Tab Cài đặt -->
            <TabItem Header="Cài đặt">
                <Grid Margin="16">
                    <StackPanel>
                        <TextBlock Text="Cài đặt" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                        
                        <Label Content="Đường dẫn FFmpeg:"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SettingsViewModel.FfmpegPath}" Grid.Column="0" Margin="0,0,8,0" IsReadOnly="True"/>
                        </Grid>
                        <TextBlock Text="{Binding SettingsViewModel.FfmpegVersion, StringFormat='Phiên bản: {0}'}"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"
                                   Text="FFmpeg đi kèm app. Encode dùng NVENC (GPU); overlay/phụ đề vẫn chạy CPU nên CPU khoảng 50% là bình thường. RTX 5060 chạy 2 job cùng lúc được."/>

                        <Label Content="Số video mỗi lượt một nguồn:"/>
                        <TextBox Width="80" HorizontalAlignment="Left" Margin="0,0,0,4"
                                 IsEnabled="{Binding QueueViewModel.CanEditBatchSize}"
                                 Text="{Binding SettingsViewModel.QueueBatchSize, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"
                                   Text="Ví dụ 9: mỗi lần thêm nguồn, hàng chính nhận 9 video nguồn đó. Phần còn lại nằm bên phải. Khi hàng chính hết video đang chờ, nạp tiếp 9 video mỗi nguồn. Chỉ sửa khi không có video đang render."/>

                        <Label Content="Kích thước video xuất:"/>
                        <ComboBox ItemsSource="{Binding SettingsViewModel.RenderHeightOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Height"
                                  SelectedValue="{Binding SettingsViewModel.RenderHeight}"
                                  Width="200" HorizontalAlignment="Left"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16"
                                   Text="Áp dụng cho mọi lần render. 720p ghép nền, avatar và sóng trên GPU. 480p giữ graph CPU vì nhanh hơn trên máy này."/>

                        <Label Content="Số video render cùng lúc:"/>
                        <ComboBox ItemsSource="{Binding SettingsViewModel.ParallelOptions}"
                                  SelectedItem="{Binding SettingsViewModel.ParallelCount}"
                                  Width="200" HorizontalAlignment="Left"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16"
                                   Text="1 = lần lượt. 2 = hai video song song (khuyến nghị khi có NVENC). 3 chỉ khi GPU còn trống nhiều."/>

                        <Label Content="Phóng nền (Background scale):"/>
                        <DockPanel Margin="0,0,0,4" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Width="48"
                                       Text="{Binding SettingsViewModel.BackgroundScalePercent, StringFormat={}{0}%}"/>
                            <Slider Minimum="100" Maximum="250" TickFrequency="10" IsSnapToTickEnabled="True"
                                    SmallChange="10" LargeChange="10"
                                    Value="{Binding SettingsViewModel.BackgroundScalePercent, UpdateSourceTrigger=PropertyChanged}"
                                    Width="280" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="100% = phủ vừa khung (cover). 150% = phóng 1.5x rồi crop giữa (mặc định). Đổi scale sẽ tạo cache nền mới."/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
