<UserControl x:Class="VideoAutoTool.App.Views.DesignCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VideoAutoTool.App.ViewModels">
    <Grid Background="#111111">
        <Viewbox Stretch="Uniform">
            <Canvas Width="1280" Height="720" Background="#000000">
                <Border Canvas.Left="0" Canvas.Top="0" Width="1280" Height="720"
                        BorderBrush="#444444" BorderThickness="2"/>
                <Border Canvas.Left="{Binding BoxX}" Canvas.Top="{Binding BoxY}"
                        Width="{Binding BoxWidth}" Height="{Binding BoxHeight}"
                        BorderBrush="#FFD700" BorderThickness="2" Background="#33FFD700">
                    <TextBlock Text="{Binding SelectedPreset.Font, FallbackValue=Sub}"
                               Foreground="White" FontSize="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
