<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FrameRender</RootNamespace>
    <AssemblyName>FrameRender</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FastEdition)' == 'true'">
    <DefineConstants>$(DefineConstants);FRAME_FAST_EDITION</DefineConstants>
    <AssemblyName>FrameRender2</AssemblyName>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FastEditionB)' == 'true'">
    <DefineConstants>$(DefineConstants);FRAME_FAST_EDITION_B</DefineConstants>
    <AssemblyName>FrameRender3</AssemblyName>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoAutoTool.Core\VideoAutoTool.Core.csproj" />
  </ItemGroup>

</Project>
