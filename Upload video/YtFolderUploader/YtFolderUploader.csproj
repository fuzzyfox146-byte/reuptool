<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>YtFolderUploader</RootNamespace>
    <AssemblyName>YtFolderUploader</AssemblyName>
    <Version>1.0.0</Version>
    <Product>YouTube Folder Uploader</Product>
    <Description>Quét thư mục video và thumbnail, hẹn giờ đăng lên YouTube theo từng kênh.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.YouTube.v3" Version="1.77.0.4291" />
  </ItemGroup>

</Project>
